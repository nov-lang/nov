; nov run tests/array-selection.nov
; nov test tests/array-selection.nov

let std = @import("std")

let Row = struct {
    values: [][]int,
}

let Color = enum {
    red,
    blue,
}

let Payload = union {
    row: Row,
    none,
}

@[test]
let reverse_visit_order_and_shortcircuit: () = {
    let items: []int = [3, 1, 4, 2]
    let mut seen: int = 0
    let mut calls: int = 0
    let found = std.array.findLast(
        items,
        (value: int) -> bool {
            seen = seen * 10 + value
            calls += 1
            value > 2
        }
    )
    @assert(found.unwrapOr(0) == 4 and seen == 24 and calls == 2)
    seen = 0
    calls = 0
    @assert(
        std.array.findLast(
            items,
            (value: int) -> bool {
                seen = seen * 10 + value
                calls += 1
                false
            }
        ).isNone()
    )
    @assert(seen == 2413 and calls == 4)
    @assert(items[0] == 3 and items[3] == 2)
    let yes = (value: int) -> bool { true }
    @assert(std.array.findLast(items, yes).unwrapOr(0) == 2)
    @assert(std.array.findLast(@as([]int, [7]), yes).unwrapOr(0) == 7)
}

@[test]
let typed_empty_no_predicate_calls: () = {
    let empty: []str = []
    let mut calls: int = 0
    @assert(
        std.array.findLast(
            empty,
            (value: str) -> bool {
                calls += 1
                true
            }
        ).isNone()
    )
    @assert(calls == 0)
    @assert(@len(std.array.take(empty, 0)) == 0)
    @assert(@len(std.array.drop(empty, 0)) == 0)
    @assert(@len(std.array.take(empty, ~@as(uint, 0))) == 0)
    @assert(@len(std.array.drop(empty, ~@as(uint, 0))) == 0)
}

@[test]
let take_drop_boundaries_and_order: () = {
    let items: []int = [3, 1, 4, 2]
    let prefix = std.array.take(items, 2)
    let suffix = std.array.drop(items, 2)
    @assert(@len(prefix) == 2 and prefix[0] == 3 and prefix[1] == 1)
    @assert(@len(suffix) == 2 and suffix[0] == 4 and suffix[1] == 2)
    @assert(@len(std.array.take(items, 0)) == 0)
    @assert(@len(std.array.drop(items, 0)) == 4)
    @assert(@len(std.array.take(items, 4)) == 4)
    @assert(@len(std.array.drop(items, 4)) == 0)
    @assert(@len(std.array.take(items, 99)) == 4)
    @assert(@len(std.array.drop(items, 99)) == 0)
    @assert(@len(std.array.take(items, ~@as(uint, 0))) == 4)
    @assert(@len(std.array.drop(items, ~@as(uint, 0))) == 0)
    @assert(std.array.take(@as([]int, [7]), 1)[0] == 7)
    @assert(@len(std.array.drop(@as([]int, [7]), 1)) == 0)
    @assert(@len(items) == 4 and items[0] == 3 and items[3] == 2)
}

let check_family: (items: []`T) = {
    let yes = (value: `U) -> bool { true }
    @assert(std.array.findLast(items, yes).isSome())
    @assert(@len(std.array.take(items, 1)) == 1)
    @assert(@len(std.array.drop(items, 1)) == @len(items) - 1)
    let empty: []`T = []
    @assert(std.array.findLast(empty, yes).isNone())
    @assert(@len(std.array.take(empty, 1)) == 0)
    @assert(@len(std.array.drop(empty, 1)) == 0)
}

@[test]
let generic_storable_families: () = {
    check_family([false, true])
    check_family(@as([]i8, [-2, 3]))
    check_family(@as([]uint, [1, 2]))
    check_family(@as([]f32, [1.5, 2.5]))
    check_family(@as([]f64, [1.5, 2.5]))
    check_family(['λ', '😀'])
    check_family(["é", "e\u{301}\0"])
    check_family(@as([]Color, [.red, .blue]))
    check_family(@as([][]int, [[1], [2, 3]]))
    check_family([Row.[ values = [[1]] ], Row.[ values = [[2]] ]])
    check_family(@as([]Payload, [.none[], .row[Row.[ values = [[3]] ]]]))
    check_family([1..3, 4..6])
    let yes = (value: `T) -> bool { true }
    @assert(std.array.findLast(["first", "last"], yes).unwrapOr("") == "last")
    @assert(std.array.take(@as([]Color, [.blue, .red]), 1)[0] == .blue)
    @assert(std.array.drop(['λ', '😀'], 1)[0] == '😀')
}

@[test]
let recursive_copies_in_both_directions: () = {
    let mut source = [Row.[ values = [[1, 2], [3]] ], Row.[ values = [[4]] ]]
    let mut taken = std.array.take(source, 2)
    let mut dropped = std.array.drop(source, 0)
    let found = std.array.findLast(source, (value: Row) -> bool { true })
    let mut row = taken[0]
    let mut inner = row.values[0]
    inner[0] = 8
    row.values[0] = inner
    taken[0] = row
    @assert(source[0].values[0][0] == 1 and dropped[0].values[0][0] == 1)
    source[1] = Row.[ values = [[9]] ]
    @assert(taken[1].values[0][0] == 4 and dropped[1].values[0][0] == 4)
    @assert(found.unwrapOr(Row.[ values = [] ]).values[0][0] == 4)
    dropped[0] = Row.[ values = [[7]] ]
    @assert(source[0].values[0][0] == 1 and taken[0].values[0][0] == 8)
    let mut nested: [][]int = [[5, 6]]
    let nestedCopy = std.array.drop(nested, 0)
    nested[0] = [99]
    @assert(nestedCopy[0][0] == 5 and @len(nestedCopy[0]) == 2)
    let mut payloads: []Payload = [.row[Row.[ values = [[10]] ]]]
    let kept = std.array.take(payloads, 1)
    payloads[0] = .none[]
    @assert(
        match kept[0] {
            .row[value] => value.values[0][0] == 10
            .none => false
        }
    )
}

@[test]
let predicate_mutations_preserve_snapshot: () = {
    let mut source: []int = [1, 2, 3]
    let mut seen: int = 0
    let found = std.array.findLast(
        source,
        (value: int) -> bool {
            seen = seen * 10 + value
            source[0] = 9
            value == 1
        }
    )
    @assert(seen == 321 and found.unwrapOr(0) == 1 and source[0] == 9)
}

@[test]
let closures_share_capture_environments: () = {
    let mut count: int = 0
    let next = () -> int {
        count += 1
        count
    }
    let functions: []() -> int = [next, next]
    check_family(functions)
    let taken = std.array.take(functions, 1)
    let dropped = std.array.drop(functions, 1)
    let found = std.array.findLast(functions, (value: () -> int) -> bool { true }).unwrapOr(next)
    @assert(count == 0)
    @assert(taken[0]() == 1 and dropped[0]() == 2 and found() == 3)
    @assert(functions[0]() == 4 and next() == 5)
}

@[test]
let eager_arguments_once_left_to_right: () = {
    let mut events: int = 0
    let mut source: []int = [1, 2, 3]
    let taken = std.array.take(
        {
            events = events * 10 + 1
            source
        },
        {
            events = events * 10 + 2
            source[0] = 9
            @as(uint, 2)
        }
    )
    @assert(events == 12 and taken[0] == 1 and source[0] == 9)
    events = 0
    let dropped = std.array.drop(
        {
            events = events * 10 + 1
            source
        },
        {
            events = events * 10 + 2
            source[1] = 8
            @as(uint, 1)
        }
    )
    @assert(events == 12 and dropped[0] == 2 and source[1] == 8)
}

let main: () = {
    let numbers: []int = [3, 1, 4, 2]
    @println("Numbers:", numbers)
    @println(
        "Last above two:",
        std.array.findLast(numbers, (value: int) -> bool { value > 2 }).unwrapOr(0)
    )
    @println("Take two:", std.array.take(numbers, 2))
    @println("Drop two:", std.array.drop(numbers, 2))
    @println("Take oversized:", std.array.take(numbers, ~@as(uint, 0)))
    @println("Drop oversized:", std.array.drop(numbers, ~@as(uint, 0)))
}
