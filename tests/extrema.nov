let std = @import("std")

let Entry = struct {
    key: int,
    name: str,
    values: []int,

    @[operator(.less_than)]
    let lessThan: (left: Entry, right: Entry) -> bool = left.key < right.key
}

let main: () = {
    @println("Minimum:", @min(9, 3, 7))
    @println("Maximum:", @max([2, 8, 3]))
    let first = Entry.[ key = 1, name = "first", values = [1] ]
    let second = Entry.[ key = 2, name = "second", values = [2] ]
    @println("Best:", @max(first, second).name)
}

@[test]
let exact_contextual_types_and_numeric_bounds: () = {
    @assert(@min(4, -2, 7, 1) == -2 and @max([4, -2, 7, 1]) == 7)
    let small: u8 = @min(3, 1, 2)
    @assert(small == 1 and @min(3, @as(u8, 1), 2) == @as(u8, 1))
    @assert(@max(@as(u64, 1), 18446744073709551615) == @as(u64, 18446744073709551615))
    @assert(@min(@as(i64, -9223372036854775808), 0) == @as(i64, -9223372036854775808))
    @assert(@max(1, 2.5) == 2.5 and @min([1, 2.5]) == 1.0)
    let narrowed: f32 = @min(1.5, 2.5)
    @assert(narrowed == @as(f32, 1.5))
    @assert(@min([7]) == 7 and @max([7]) == 7)
}

@[test]
let custom_order_stable_ties_and_independent_results: () = {
    let first = Entry.[ key = 1, name = "first", values = [1] ]
    let tied = Entry.[ key = 1, name = "tied", values = [2] ]
    let higher = Entry.[ key = 3, name = "higher", values = [3] ]
    @assert(@min(first, tied).name == "first")
    @assert(@max([first, tied]).name == "first")
    let source = [first, higher, tied]
    let mut selected = @max(source)
    selected.values[0] = 9
    @assert(selected.name == "higher" and selected.values == [9])
    @assert(source[1].values == [3] and higher.values == [3])
}

let Ranked = enum {
    low,
    high,

    @[operator(.less_than)]
    let lessThan: (left: Ranked, right: Ranked) -> bool = left == .low and right == .high
}
let Amount = union {
    number: int,
    empty,

    let value: (self: Amount) -> int = match self {
        .number[number] => number
        .empty => 0
    }
    @[operator(.less_than)]
    let lessThan: (left: Amount, right: Amount) -> bool = left.value() < right.value()
}

@[test]
let enum_union_and_generic_ordering: () = {
    @assert(@min(Ranked.high, .low) == Ranked.low)
    @assert(@max([Ranked.low, .high]) == Ranked.high)
    @assert(@min([.high, Ranked.low]) == Ranked.low)
    let rankedQuery: @TypeOf(@min([.high, Ranked.low])) = .low
    @assert(rankedQuery == Ranked.low)
    @assert(@max([
        .[ key = 1, name = "first", values = [] ],
        Entry.[ key = 2, name = "second", values = [] ]
    ]).key == 2)
    let entryQuery: @TypeOf(@min([
        .[ key = 1, name = "first", values = [] ],
        Entry.[ key = 2, name = "second", values = [] ]
    ])) = .[
        key = 0,
        name = "query",
        values = []
    ]
    @assert(entryQuery.key == 0)
    @assert(@min([.number[-2], Amount.empty[]]) == Amount.number[-2])
    let amountQuery: @TypeOf(@min([.number[-2], Amount.empty[]])) = .empty[]
    @assert(amountQuery == Amount.empty[])
    let amount: Amount = @min(.number[-2], Amount.empty[])
    @assert(amount == Amount.number[-2])
    let values = [Box(uint).[ value = 2 ], Box(uint).[ value = 1 ]]
    @assert(@min(values).value == 1)
    @assert(smallest([1, 3, 2]) == 1 and greatest(@as(u8, 1), 3) == @as(u8, 3))
    @assert(std.array.map([[1, 3], [4, 2]], smallest) == [1, 2])
}

let Box: (T: type) -> type = struct {
    value: T,

    @[operator(.less_than)]
    let lessThan: (left: @This(), right: @This()) -> bool = left.value < right.value
}
let smallest: (items: []`T) -> `T = @min(items)
let greatest: (left: `T, right: `T) -> `T = @max(left, right)

@[test]
let float_nan_and_signed_zero_keep_the_first_value: () = {
    let zero: f64 = 0.0
    let nan = zero / zero
    let firstNaN = @min(nan, 1.0, -3.0)
    @assert(firstNaN != firstNaN)
    let maxNaN = @max([nan, 1.0, 3.0])
    @assert(maxNaN != maxNaN)
    @assert(@max(1.0, nan, 2.0) == 2.0 and @min([1.0, nan, -2.0]) == -2.0)
    @assert(1.0 / @min(-zero, zero) < 0.0)
    @assert(1.0 / @max([-zero, zero]) < 0.0)
    @assert(1.0 / @min(zero, -zero) > 0.0)
    @assert(1.0 / @max([zero, -zero]) > 0.0)
}

let Probe = struct {
    key: int,
    run: () -> bool,

    @[operator(.less_than)]
    let lessThan: (left: Probe, right: Probe) -> bool = left.run() and left.key < right.key
}

@[test]
let arguments_are_eager_and_comparisons_run_afterwards: () = {
    let mut events: []int = []
    let compare = () -> bool {
        events += [9]
        true
    }
    let make = (key: int) -> Probe {
        events += [key]
        Probe.[ key, run = compare ]
    }
    @assert(@max(make(1), make(3), make(2)).key == 3)
    @assert(events == [1, 3, 2, 9, 9])
    events = []
    @assert(@min([make(3), make(1), make(2)]).key == 1)
    @assert(events == [3, 1, 2, 9, 9])
    events = []
    @assert(@max([make(7)]).key == 7 and events == [7])
    events = []
    let stop = () -> int {
        @max(make(1), { return 7 }, make(2))
    }
    @assert(stop() == 7 and events == [1])
    events = []
    let stopArray = () -> int {
        @min([
            make(3),
            { return 8 },
            make(4)
        ])
    }
    @assert(stopArray() == 8 and events == [3])
}

@[test]
let array_snapshot_survives_comparator_owner_mutation: () = {
    let mut source: []Probe = []
    let mut calls: uint = 0
    let mutate = () -> bool {
        calls += 1
        @clear(source)
        true
    }
    source = [Probe.[ key = 3, run = mutate ], Probe.[ key = 1, run = mutate ], Probe.[ key = 2, run = mutate ]]
    let result = @min(source)
    @assert(result.key == 1 and calls == 2 and @len(source) == 0)
}

let knownMinimum = @min([4, 1, 3])
let knownMaximum = @max(1, 7, 2)

@[test]
let known_data_globals_and_unevaluated_queries: () = {
    @assert(knownMinimum == 1 and knownMaximum == 7)
    let emptyQuery: @TypeOf(@min(@as([]int, []))) = 0
    @assert(emptyQuery == 0)
    let mut calls = 0
    let make = () -> Entry {
        calls += 1
        Entry.[ key = calls, name = "query", values = [calls] ]
    }
    let query: @TypeOf(@max(make(), make())) = Entry.[ key = 0, name = "value", values = [] ]
    @assert(query.key == 0 and calls == 0)
    @assert(@max(make(), make()).key == 2 and calls == 2)
}
