let combined = [1, 2] + [3]
let concat: (left: []`T, right: []`T) -> []`T = left + right

let main: () = {
    let first = ["Ada", "Grace"]
    let second = ["Linus"]
    @println("Combined: {first + second}")
    @println("Numbers: {combined}")
}

@[test]
let empty_chained_and_contextual_arrays: () = {
    let empty: []u8 = [] + []
    let bytes: []u8 = [] + [1] + [2, 3] + []
    @assert(@len(empty) == 0 and @len(bytes) == 3)
    @assert(bytes[0] == 1 and bytes[-1] == 3)
    @assert(@len(combined) == 3 and combined[-1] == 3)
}

@[test]
let nested_storage_is_independent: () = {
    let mut left = [[1]]
    let mut right = [[2]]
    let mut joined = left + right
    left[0] = [10]
    right[0] = [20]
    @assert(joined[0][0] == 1 and joined[1][0] == 2)
    joined[0] = [30]
    @assert(left[0][0] == 10 and right[0][0] == 20)
    let doubled = joined + joined
    @clear(joined)
    @assert(@len(doubled) == 4 and doubled[2][0] == 30)
}

let Entry = struct {
    scores: []int,
}
let Message = union {
    entry: Entry,
    none,
}

@[test]
let storable_element_types: () = {
    let flags = [true] + [false]
    let floats: []f32 = [1.5] + [2.5]
    let runes = ['é'] + ['😀']
    let entries = [Entry.[ scores = [1] ]] + [Entry.[ scores = [2] ]]
    let messages: []Message = [.entry[entries[0]]] + [.none[]]
    let functions: []() -> int = [
        () -> int { 1 }
    ] + [
        () -> int { 2 }
    ]
    let ranges = [0..2] + [2..4]
    @assert(flags[0] and flags[1] == false)
    @assert(floats[0] + floats[1] == 4.0 and runes[1] == '😀')
    @assert(entries[1].scores[0] == 2 and @len(messages) == 2)
    @assert(functions[0]() == 1 and functions[1]() == 2)
    @assert(@len(ranges[0]) == 2 and @len(ranges[1]) == 2)
}

@[test]
let operands_snapshot_before_later_effects: () = {
    let mut events = 0
    let left = () -> []int {
        events = events * 10 + 1
        [1]
    }
    let right = () -> []int {
        events = events * 10 + 2
        [2]
    }
    let result = left() + right()
    @assert(events == 12 and result[0] == 1 and result[1] == 2)

    let mut items = [[3]]
    let change = () -> [][]int {
        items[0] = [9]
        items
    }
    let saved = items + change()
    @assert(saved[0][0] == 3 and saved[1][0] == 9)
    let p = &items
    let referenced = p.* + {
        p.* = [[8]]
        p.*
    }
    @assert(referenced[0][0] == 9 and referenced[1][0] == 8)
    let indexed = [1] + items[
        {
            items = [[6]]
            0
        }]
    @assert(indexed[1] == 8 and items[0][0] == 6)
}

@[test]
let generics_callbacks_and_unevaluated_queries: () = {
    let values: []u8 = concat([], [7])
    let callback = (a: []int, b: []int) { a + b }
    let result = callback([1], [2])
    let mut calls = 0
    let effect = () -> []u8 {
        calls += 1
        [9]
    }
    let query: @TypeOf(values + effect()) = []
    @assert(@len(query) == 0 and calls == 0)
    @assert(values[0] == 7 and result[-1] == 2)
}
