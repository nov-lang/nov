; nov run tests/array-sort.nov --lib-dir lib
; nov test tests/array-sort.nov --lib-dir lib

let std = @import("std")

let Row = struct {
    key: int,
    name: str,
    values: [][]int,
}

let Color = enum {
    red,
    blue,
}

let Payload = union {
    row: Row,
    none,
}

let ascending: (a: int, b: int) -> bool = a < b
let descending: (a: int, b: int) -> bool = a > b
let by_key: (a: Row, b: Row) -> bool = a.key < b.key
let payload_key: (value: Payload) -> int = match value {
    .row[row] => row.key
    .none => 0
}

let assert_numbers: (actual: []int, expected: []int) = {
    @assert(@len(actual) == @len(expected))
    loop value, wanted in actual, expected {
        @assert(value == wanted)
    }
}

@[test]
let empty_and_singleton_no_comparisons: () = {
    let mut calls: uint = 0
    let less = (a: int, b: int) -> bool {
        calls += 1
        a < b
    }
    let empty: []int = []
    @assert(@len(std.array.sort(empty, less)) == 0)
    assert_numbers(std.array.sort(@as([]int, [7]), less), [7])
    @assert(calls == 0)
}

@[test]
let sorted_reverse_duplicates_and_descending: () = {
    assert_numbers(std.array.sort(@as([]int, [1, 2, 3, 4]), ascending), [1, 2, 3, 4])
    assert_numbers(std.array.sort(@as([]int, [4, 3, 2, 1]), ascending), [1, 2, 3, 4])
    assert_numbers(std.array.sort(@as([]int, [3, 1, 3, 2, 1]), ascending), [1, 1, 2, 3, 3])
    assert_numbers(std.array.sort(@as([]int, [3, 1, 3, 2, 1]), descending), [3, 3, 2, 1, 1])
}

@[test]
let stable_struct_keys_and_all_equal: () = {
    let rows = [
        Row.[ key = 2, name = "a", values = [] ],
        Row.[ key = 1, name = "b", values = [] ],
        Row.[ key = 2, name = "c", values = [] ],
        Row.[ key = 1, name = "d", values = [] ]
    ]
    let sorted = std.array.sort(rows, by_key)
    @assert(sorted[0].name == "b" and sorted[1].name == "d")
    @assert(sorted[2].name == "a" and sorted[3].name == "c")
    let unchanged = std.array.sort(rows, (a: Row, b: Row) -> bool { false })
    @assert(unchanged[0].name == "a" and unchanged[1].name == "b")
    @assert(unchanged[2].name == "c" and unchanged[3].name == "d")
    @assert(rows[0].name == "a" and rows[1].name == "b")
}

@[test]
let strings_runes_and_finite_floats: () = {
    let words = std.array.sort(
        ["pear", "a", "fig", "bb"],
        (a: str, b: str) -> bool { @len(a) < @len(b) }
    )
    @assert(words[0] == "a" and words[1] == "bb" and words[2] == "fig" and words[3] == "pear")
    let runes = std.array.sort(
        ['😀', 'λ', 'a'],
        (a: rune, b: rune) -> bool { a == 'a' and b != 'a' or a == 'λ' and b == '😀' }
    )
    @assert(runes[0] == 'a' and runes[1] == 'λ' and runes[2] == '😀')
    let small = std.array.sort(@as([]f32, [2.5, -1.5, 0.0]), (a: f32, b: f32) -> bool { a < b })
    @assert(small[0] == -1.5 and small[1] == 0.0 and small[2] == 2.5)
    let wide = std.array.sort(@as([]f64, [-1.5, 2.5, 0.0]), (a: f64, b: f64) -> bool { a > b })
    @assert(wide[0] == 2.5 and wide[1] == 0.0 and wide[2] == -1.5)
}

@[test]
let bool_integer_enum_union_and_range_elements: () = {
    let flags = std.array.sort([true, false, true], (a: bool, b: bool) -> bool { a == false and b })
    @assert(flags[0] == false and flags[1] and flags[2])
    let signed = std.array.sort(@as([]i8, [3, -2, 1]), (a: i8, b: i8) -> bool { a < b })
    @assert(signed[0] == -2 and signed[1] == 1 and signed[2] == 3)
    let unsigned = std.array.sort(@as([]uint, [3, 1, 2]), (a: uint, b: uint) -> bool { a < b })
    @assert(unsigned[0] == 1 and unsigned[1] == 2 and unsigned[2] == 3)
    let colors = std.array.sort(
        @as([]Color, [.blue, .red, .blue]),
        (a: Color, b: Color) -> bool { a == .red and b == .blue }
    )
    @assert(colors[0] == .red and colors[1] == .blue and colors[2] == .blue)
    let payloads = std.array.sort(
        @as(
            []Payload,
            [.row[Row.[ key = 2, name = "two", values = [[2]] ]], .none[], .row[Row.[ key = 1, name = "one", values = [[1]] ]]]
        ),
        (a: Payload, b: Payload) -> bool { payload_key(a) < payload_key(b) }
    )
    @assert(
        payload_key(
            payloads[0]
        ) == 0 and payload_key(
            payloads[1]
        ) == 1 and payload_key(
            payloads[2]
        ) == 2
    )
    let ranges = std.array.sort(
        [@as(int, 4)..6, @as(int, 1)..3],
        (a: `T, b: `T) -> bool {
            let mut left: int = 0
            let mut right: int = 0
            loop value in a {
                left += value
            }
            loop value in b {
                right += value
            }
            left < right
        }
    )
    let mut total: int = 0
    loop value in ranges[0] {
        total += value
    }
    @assert(total == 3)
}

@[test]
let nested_arrays_and_records_copy_independently: () = {
    let mut source: [][]int = [[3, 4], [1]]
    let mut sorted = std.array.sort(source, (a: []int, b: []int) -> bool { @len(a) < @len(b) })
    let inner = &sorted[0]
    inner.*[0] = 9
    @assert(source[1][0] == 1 and source[0][0] == 3)
    source[0] = [8]
    @assert(sorted[1][0] == 3 and @len(sorted[1]) == 2)
    let mut rows = [Row.[ key = 2, name = "two", values = [[2]] ], Row.[ key = 1, name = "one", values = [[1]] ]]
    let mut result = std.array.sort(rows, by_key)
    let mut row = result[0]
    let mut values = row.values[0]
    values[0] = 7
    row.values[0] = values
    result[0] = row
    @assert(rows[1].values[0][0] == 1)
    rows[0] = Row.[ key = 9, name = "nine", values = [[9]] ]
    @assert(result[1].key == 2 and result[1].values[0][0] == 2)
}

@[test]
let function_elements_share_closure_captures: () = {
    let mut count: int = 0
    let high = () -> int {
        count += 1
        2
    }
    let low = () -> int {
        count += 1
        1
    }
    let source: []() -> int = [high, low]
    let sorted = std.array.sort(source, (a: () -> int, b: () -> int) -> bool { a() < b() })
    @assert(count == 2)
    @assert(sorted[0]() == 1 and sorted[1]() == 2 and count == 4)
    @assert(source[0]() == 2 and count == 5)
}

@[test]
let comparator_capture_and_comparison_order: () = {
    let mut seen: []int = []
    let mut calls: uint = 0
    let reverse = false
    let sorted = std.array.sort(
        @as([]int, [3, 1, 2]),
        (a: int, b: int) -> bool {
            seen += [a, b]
            calls += 1
            if reverse { a > b } else { a < b }
        }
    )
    assert_numbers(sorted, [1, 2, 3])
    assert_numbers(seen, [1, 3, 2, 3, 2, 1])
    @assert(calls == 3)
}

@[test]
let arguments_once_left_to_right_and_source_snapshot: () = {
    let mut events: int = 0
    let mut source: []int = [3, 1, 2]
    let sorted = std.array.sort(
        {
            events = events * 10 + 1
            source
        },
        {
            events = events * 10 + 2
            source[0] = 9
            (a: int, b: int) -> bool {
                source[1] = 8
                a < b
            }
        }
    )
    @assert(events == 12)
    assert_numbers(sorted, [1, 2, 3])
    assert_numbers(source, [9, 8, 2])
}

let main: () = {
    let numbers: []int = [3, 1, 2, 1]
    @println("Source:", numbers)
    @println("Ascending:", std.array.sort(numbers, ascending))
    @println("Descending:", std.array.sort(numbers, descending))
    let rows = [Row.[ key = 2, name = "Ada", values = [] ], Row.[ key = 1, name = "Bo", values = [] ], Row.[ key = 2, name = "Cy", values = [] ]]
    let sorted = std.array.sort(rows, by_key)
    @println("Stable keys:", sorted[0].name, sorted[1].name, sorted[2].name)
    @println("Source unchanged:", numbers)
}
