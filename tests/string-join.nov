; nov run tests/string-join.nov
; nov test tests/string-join.nov

let std = @import("std")

@[test]
let empty_singleton_and_empty_separator: () = {
    let empty: []str = []
    @assert(std.string.join(empty, ",") == "")
    @assert(std.string.join(empty, "") == "")
    @assert(std.string.join(["only"], "ignored") == "only")
    @assert(std.string.join([""], "ignored") == "")
    @assert(std.string.join(["a", "", "b"], "") == "ab")
}

@[test]
let separators_and_empty_parts: () = {
    @assert(std.string.join(["red", "green", "blue"], ", ") == "red, green, blue")
    @assert(std.string.join(["", "red", "", "blue", ""], "::") == "::red::::blue::")
    @assert(std.string.join(["", "", ""], ",") == ",,")
    let parts = std.string.split(",red,,blue,", ",")
    @assert(std.string.join(parts, ",") == ",red,,blue,")
}

@[test]
let exact_utf8_nul_and_no_normalization: () = {
    let joined = std.string.join(["é", "e\u{301}", "😀\0"], "\0λ")
    @assert(joined == "é\0λe\u{301}\0λ😀\0")
    @assert(std.string.join(["e", "\u{301}"], "") == "e\u{301}")
    @assert(std.string.join(["e", "\u{301}"], "") != "é")
    @assert(std.string.join(["a\0", "\0b"], "\0") == "a\0\0\0b")
}

let retained_join: () -> str = {
    let mut source = "prefix:é😀:suffix"
    let part = source[7..9]
    let mut parts = [part, "e\u{301}"]
    let joined = std.string.join(parts, "\0")
    parts[0] = "changed"
    source = "replacement"
    @assert(parts[0] == "changed" and source == "replacement")
    joined
}

@[test]
let retained_result_and_source_unaffected: () = {
    let mut parts = ["first", "second"]
    let joined = std.string.join(parts, "/")
    @assert(@len(parts) == 2 and parts[0] == "first" and parts[1] == "second")
    parts[0] = "changed"
    @assert(joined == "first/second")
    let retained = retained_join()
    loop i in 0..2000 {
        let temporary = "allocation:{i}:😀"
        @assert(@len(temporary) > 0)
    }
    @assert(retained == "é😀\0e\u{301}")
}

@[test]
let eager_arguments_once_left_to_right: () = {
    let mut events: int = 0
    let mut parts = ["a", "b"]
    let joined = std.string.join(
        {
            events = events * 10 + 1
            parts
        },
        {
            events = events * 10 + 2
            parts[0] = "changed"
            ":"
        }
    )
    @assert(events == 12 and joined == "a:b" and parts[0] == "changed")
}

let main: () = {
    @println("Joined:", std.string.join(["red", "green", "blue"], ", "))
    @println("Empty fields:", std.string.join(["", "red", "", "blue", ""], "|"))
    @println("Concatenated:", std.string.join(["é", "😀", "e\u{301}"], ""))
    let empty: []str = []
    @println("Empty: [{std.string.join(empty, ",")}]")
}
