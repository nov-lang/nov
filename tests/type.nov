let MyInt = int

@[public]
let MyType = struct {
    x: MyInt = 0,
    y: str = "hello",
    z: bool,

    @[public]
    @[stringify]
    let toString: (self: MyType) -> str = "x: {self.x}, y: {self.y}. z: {self.z}"
}

let main: () = {
    let item = MyType.[ x = 5, z = true ]
    @println(item) ; @println will call the @[stringify] method
}
