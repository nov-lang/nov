let std = @import("std")
let array = std.array

let present: (value: std.Option(`T)) -> `T = match value {
    .some[item] => item
    .none => @panic("expected some")
}

let main: () = {
    @println(
        "Minimum:",
        present(array.min([9, 3, 7]))
    )
    @println(
        "Maximum:",
        present(array.max([2, 8, 3]))
    )
    @println("Empty:", array.min(@as([]int, [])).isNone())
}

@[test]
let empty_singleton_and_exact_numeric_types: () = {
    let empty: []int = []
    @assert(array.min(empty) == std.Option(int).none[])
    @assert(array.max(empty) == std.Option(int).none[])
    @assert(
        present(array.min([7])) == 7 and present(array.max([7])) == 7
    )
    let low: std.Option(i8) = array.min([@as(i8, -128), 127, 0])
    let high: std.Option(u8) = array.max([@as(u8, 0), 255, 1])
    @assert(
        present(low) == @as(i8, -128) and present(high) == @as(u8, 255)
    )
    let wide: std.Option(u64) = array.max([@as(u64, 1), 18446744073709551615])
    @assert(
        present(wide) == @as(u64, 18446744073709551615)
    )
    let small: std.Option(f32) = array.min([@as(f32, 1.5), 2.5])
    let large: std.Option(f64) = array.max([@as(f64, 1.5), 2.5])
    @assert(
        present(small) == @as(f32, 1.5) and present(large) == @as(f64, 2.5)
    )
    @assert(array.min(@as([]u8, [])) == std.Option(u8).none[])
    @assert(array.max(@as([]f32, [])) == std.Option(f32).none[])
}

let Entry = struct {
    key: int,
    name: str,
    values: [][]int,

    @[public]
    @[operator(.less_than)]
    let lessThan: (left: Entry, right: Entry) -> bool = left.key < right.key
}

@[test]
let stable_ties_and_recursive_storage_independence: () = {
    let first = Entry.[ key = 1, name = "first", values = [[1]] ]
    let tied = Entry.[ key = 1, name = "tied", values = [[2]] ]
    let higher = Entry.[ key = 3, name = "higher", values = [[3]] ]
    @assert(
        present(array.min([first, tied])).name == "first"
    )
    @assert(
        present(array.max([first, tied])).name == "first"
    )
    let mut source = [first, higher, tied]
    let chosen = array.max(source)
    let mut selected = present(chosen)
    let mut other = present(chosen)
    selected.values = [[9]]
    other.values = [[3, 4]]
    source[1] = Entry.[ key = 3, name = "changed", values = [[8]] ]
    @assert(selected.values == [[9]] and other.values == [[3, 4]])
    @assert(
        present(chosen).values == [[3]] and higher.values == [[3]]
    )
    @assert(source[1].values == [[8]])
    let mut least = present(array.min([higher, first]))
    least.values = [[7]]
    @assert(first.values == [[1]] and least.values == [[7]])
}

let Ranked = enum {
    low,
    high,

    @[public]
    @[operator(.less_than)]
    let lessThan: (left: Ranked, right: Ranked) -> bool = left == .low and right == .high
}
let Amount = union {
    number: int,
    empty,

    let value: (self: Amount) -> int = match self {
        .number[number] => number
        .empty => 0
    }
    @[public]
    @[operator(.less_than)]
    let lessThan: (left: Amount, right: Amount) -> bool = left.value() < right.value()
}
let Box: (T: type) -> type = struct {
    value: T,

    @[public]
    @[operator(.less_than)]
    let lessThan: (left: @This(), right: @This()) -> bool = left.value < right.value
}

@[test]
let enum_union_generic_hooks_and_callbacks: () = {
    @assert(
        present(array.min([Ranked.high, .low])) == Ranked.low
    )
    @assert(
        present(array.max([Ranked.low, .high])) == Ranked.high
    )
    @assert(
        present(array.min([Amount.number[-2], .empty[]])) == Amount.number[-2]
    )
    @assert(
        present(array.max([Amount.number[-2], .empty[]])) == Amount.empty[]
    )
    let values = [Box(uint).[ value = 2 ], Box(uint).[ value = 1 ]]
    @assert(
        present(array.min(values)).value == 1 and present(array.max(values)).value == 2
    )
    @assert(array.min(@as([]Ranked, [])) == std.Option(Ranked).none[])
    @assert(array.max(@as([]Amount, [])) == std.Option(Amount).none[])
    @assert(array.min(@as([]Box(uint), [])) == std.Option(Box(uint)).none[])
    let minimum: ([]u8) -> std.Option(u8) = array.min
    let maximum: ([]u8) -> std.Option(u8) = array.max
    @assert(
        present(minimum([3, 1])) == @as(u8, 1)
    )
    @assert(
        present(maximum([3, 1])) == @as(u8, 3)
    )
    let lows = array.map([[3, 1], [], [4, 2]], array.min)
    let highs = array.map([[3, 1], [], [4, 2]], array.max)
    @assert(lows == [std.Option(int).some[1], .none[], .some[2]])
    @assert(highs == [std.Option(int).some[3], .none[], .some[4]])
}

@[test]
let float_nan_and_signed_zero_preserve_first: () = {
    let zero: f64 = 0.0
    let nan = zero / zero
    let lowNaN = present(array.min([nan, 1.0, -3.0]))
    let highNaN = present(array.max([nan, 1.0, 3.0]))
    @assert(lowNaN != lowNaN and highNaN != highNaN)
    @assert(
        present(array.min([1.0, nan, -2.0])) == -2.0
    )
    @assert(
        present(array.max([1.0, nan, 2.0])) == 2.0
    )
    @assert(
        1.0 / present(array.min([-zero, zero])) < 0.0
    )
    @assert(
        1.0 / present(array.max([-zero, zero])) < 0.0
    )
    @assert(
        1.0 / present(array.min([zero, -zero])) > 0.0
    )
    @assert(
        1.0 / present(array.max([zero, -zero])) > 0.0
    )
    let smallZero: f32 = 0.0
    let smallNaN = smallZero / smallZero
    let small = present(array.min([smallNaN, 1.0]))
    @assert(small != small)
    @assert(
        @as(f32, 1.0) / present(array.max([-smallZero, smallZero])) < @as(f32, 0.0)
    )
}

let Probe = struct {
    key: int,
    run: (int, int) -> bool,

    @[public]
    @[operator(.less_than)]
    let lessThan: (left: Probe, right: Probe) -> bool = left.run(left.key, right.key) and left.key < right.key
}

@[test]
let eager_arguments_comparison_order_and_shared_cells: () = {
    let mut events: []int = []
    let compare = (left: int, right: int) -> bool {
        events += [left, right]
        true
    }
    let make = (key: int) -> Probe {
        events += [key]
        Probe.[ key, run = compare ]
    }
    @assert(
        present(array.min([make(3), make(1), make(2)])).key == 1
    )
    @assert(events == [3, 1, 2, 1, 3, 2, 1])
    events = []
    @assert(
        present(array.max([make(1), make(3), make(2)])).key == 3
    )
    @assert(events == [1, 3, 2, 1, 3, 3, 2])
    events = []
    let chosen = present(array.min([make(7)]))
    @assert(events == [7])
    events = []
    @assert(chosen.run(8, 9) and events == [8, 9])
    events = []
    @assert(array.max(@as([]Probe, [])).isNone() and events == [])
}

@[test]
let snapshots_and_typeof_queries_are_pure: () = {
    let mut source: []Probe = []
    let mut calls: uint = 0
    let mutate = (left: int, right: int) -> bool {
        calls += 1
        @clear(source)
        true
    }
    source = [Probe.[ key = 3, run = mutate ], Probe.[ key = 1, run = mutate ], Probe.[ key = 2, run = mutate ]]
    @assert(
        present(array.min(source)).key == 1 and calls == 2 and @len(source) == 0
    )
    calls = 0
    source = [Probe.[ key = 1, run = mutate ], Probe.[ key = 3, run = mutate ], Probe.[ key = 2, run = mutate ]]
    @assert(
        present(array.max(source)).key == 3 and calls == 2 and @len(source) == 0
    )
    let make = () -> []Probe {
        calls += 1
        source
    }
    let low: @TypeOf(array.min(make())) = .none[]
    let high: @TypeOf(array.max(make())) = .none[]
    let empty: @TypeOf(array.min(@as([]Probe, []))) = .none[]
    @assert(low.isNone() and high.isNone() and empty.isNone() and calls == 2)
}
