; nov run --lib-dir lib examples/string-conversions.nov
; nov test --lib-dir lib examples/string-conversions.nov
; Exact stdout:
; UTF-8 bytes: [65, 195, 169, 240, 159, 152, 128]
; Round trip: Aé😀
; Independent snapshot: Aé😀
; Invalid UTF-8: Utf8Error.invalidUtf8
; NUL: 3 bytes, 3 scalars

let std = @import("std")
let Utf8Error = std.string.Utf8Error
let TextResult = std.Result(string, Utf8Error)

let expectValid: (bytes: []u8, expected: string) = {
    let text = match std.string.fromBytes(bytes) {
        .ok => |value| value
        .err => {
            @panic("valid UTF-8 rejected")
        }
    }
    @assert(text == expected)
    let encoded = std.string.toBytes(text)
    @assert(@len(encoded) == @len(bytes))
    loop actual, original in encoded, bytes {
        @assert(actual == original)
    }
}

let expectInvalid: (bytes: []u8) = {
    match std.string.fromBytes(bytes) {
        .ok => @panic("invalid UTF-8 accepted")
        .err => |error| match error {
            .invalidUtf8 => {}
        }
    }
}

@[test]
let empty_ascii_and_nul: () = {
    expectValid([], "")
    expectValid([0, 1, 0x41, 0x7F, 0], "\0\u{1}A\u{7F}\0")
    let mut ascii: []u8 = []
    let mut byte: u8 = 0
    loop {
        ascii += [byte]
        if byte == 0x7F {
            break
        }
        byte += 1
    }
    let text = std.string.fromBytes(ascii).unwrapOr("bad")
    @assert(@len(text) == 128 and text[0] == '\0' and text[-1] == '\u{7F}')
    expectValid(ascii, text)
}

@[test]
let valid_two_and_three_byte_boundaries: () = {
    expectValid([0xC2, 0x80], "\u{80}")
    expectValid([0xDF, 0xBF], "\u{7FF}")
    expectValid([0xE0, 0xA0, 0x80], "\u{800}")
    expectValid([0xE0, 0xBF, 0xBF], "\u{FFF}")
    expectValid([0xE1, 0x80, 0x80], "\u{1000}")
    expectValid([0xEC, 0xBF, 0xBF], "\u{CFFF}")
    expectValid([0xED, 0x80, 0x80], "\u{D000}")
    expectValid([0xED, 0x9F, 0xBF], "\u{D7FF}")
    expectValid([0xEE, 0x80, 0x80], "\u{E000}")
    expectValid([0xEF, 0xBF, 0xBF], "\u{FFFF}")
}

@[test]
let valid_four_byte_boundaries_and_state_reset: () = {
    expectValid([0xF0, 0x90, 0x80, 0x80], "\u{10000}")
    expectValid([0xF0, 0xBF, 0xBF, 0xBF], "\u{3FFFF}")
    expectValid([0xF1, 0x80, 0x80, 0x80], "\u{40000}")
    expectValid([0xF3, 0xBF, 0xBF, 0xBF], "\u{FFFFF}")
    expectValid([0xF4, 0x80, 0x80, 0x80], "\u{100000}")
    expectValid([0xF4, 0x8F, 0xBF, 0xBF], "\u{10FFFF}")
    expectValid(
        [
            0xE0,
            0xA0,
            0x80,
            0xC2,
            0x80,
            0xED,
            0x9F,
            0xBF,
            0xDF,
            0xBF,
            0xF0,
            0x90,
            0x80,
            0xBF,
            0xF4,
            0x8F,
            0xBF,
            0x80,
            0
        ],
        "\u{800}\u{80}\u{D7FF}\u{7FF}\u{1003F}\u{10FFC0}\0"
    )
}

@[test]
let invalid_leads_and_stray_continuations: () = {
    let mut byte: u8 = 0x80
    loop {
        expectInvalid([byte])
        if byte == 0xC1 {
            break
        }
        byte += 1
    }
    byte = 0xF5
    loop {
        expectInvalid([byte, 0x80, 0x80, 0x80])
        if byte == 0xFF {
            break
        }
        byte += 1
    }
    expectInvalid([0xC0, 0x80])
    expectInvalid([0xC1, 0xBF])
    expectInvalid([0x41, 0, 0x80])
}

@[test]
let invalid_overlong_surrogate_and_out_of_range: () = {
    expectInvalid([0xE0, 0x80, 0x80])
    expectInvalid([0xE0, 0x9F, 0xBF])
    expectInvalid([0xED, 0xA0, 0x80])
    expectInvalid([0xED, 0xBF, 0xBF])
    expectInvalid([0xF0, 0x80, 0x80, 0x80])
    expectInvalid([0xF0, 0x8F, 0xBF, 0xBF])
    expectInvalid([0xF4, 0x90, 0x80, 0x80])
    expectInvalid([0xF4, 0xBF, 0xBF, 0xBF])
}

@[test]
let invalid_continuations_and_truncation: () = {
    expectInvalid([0xC2])
    expectInvalid([0xE0])
    expectInvalid([0xE0, 0xA0])
    expectInvalid([0xED, 0x9F])
    expectInvalid([0xF0])
    expectInvalid([0xF0, 0x90])
    expectInvalid([0xF0, 0x90, 0x80])
    expectInvalid([0xF4, 0x8F, 0xBF])
    expectInvalid([0xC2, 0x7F])
    expectInvalid([0xC2, 0xC0])
    expectInvalid([0xE1, 0x41, 0x80])
    expectInvalid([0xE1, 0x80, 0xC2])
    expectInvalid([0xF1, 0x80, 0, 0x80])
    expectInvalid([0xF1, 0x80, 0x80, 0xFF])
    expectInvalid([0x41, 0, 0xC2])
    expectInvalid([0xC2, 0x80, 0x80])
}

@[test]
let exact_bytes_no_normalization_and_copy_isolation: () = {
    let mut source = "prefix:é😀\0:suffix"
    let view = source[7..10]
    let mut bytes = std.string.toBytes(view)
    let original = std.string.fromBytes(bytes).unwrapOr("bad")
    let mut second = std.string.toBytes(view)
    bytes[0] = 0xFF
    second[0] = 0
    source = "replacement"
    @assert(source == "replacement" and view == "é😀\0" and original == view)
    expectInvalid(bytes)
    let mut input: []u8 = [0x41, 0, 0xC3, 0xA9]
    let snapshot = std.string.fromBytes(input).unwrapOr("bad")
    @assert(input[0] == 0x41 and input[2] == 0xC3)
    input[0] = 0xFF
    @assert(snapshot == "A\0é")
    expectValid([0x65, 0xCC, 0x81], "e\u{301}")
    @assert(std.string.fromBytes([0x65, 0xCC, 0x81]).unwrapOr("") != "é")
}

let retainedText: () -> string = {
    let bytes = std.string.toBytes("temporary:" + "é😀\0")
    std.string.fromBytes(bytes).unwrapOr("bad")
}

let retainedBytes: () -> []u8 = {
    let source = "prefix:" + "é😀\0:suffix"
    std.string.toBytes(source[7..10])
}

@[test]
let source_scope_and_gc_churn: () = {
    let text = retainedText()
    let bytes = retainedBytes()
    loop i in 0..2000 {
        let temporary = std.string.toBytes("allocation:{i}:😀")
        let decoded = std.string.fromBytes(temporary).unwrapOr("")
        @assert(@len(decoded) > 0)
    }
    @assert(text == "temporary:é😀\0")
    expectValid(bytes, "é😀\0")
}

let decorate: (bytes: []u8) -> TextResult = {
    let text = std.string.fromBytes(bytes).!
    .ok["[{text}]"]
}

@[test]
let propagation_error_matching_and_first_class_wrappers: () = {
    let encode: (string) -> []u8 = std.string.toBytes
    let decode: ([]u8) -> TextResult = std.string.fromBytes
    let sameEncode: @TypeOf(std.string.toBytes) = encode
    let sameDecode: @TypeOf(std.string.fromBytes) = decode
    let bytes: @TypeOf(std.string.toBytes("é")) = sameEncode("é")
    let result: @TypeOf(std.string.fromBytes(bytes)) = sameDecode(bytes)
    @assert(result.unwrapOr("bad") == "é")
    @assert(decorate(bytes).unwrapOr("bad") == "[é]")
    match decorate([0xFF]) {
        .ok => @panic("propagation accepted invalid UTF-8")
        .err => |error| {
            let typed: Utf8Error = error
            match typed {
                .invalidUtf8 => {}
            }
        }
    }
}

let main: () = {
    let mut bytes = std.string.toBytes("Aé😀")
    @println("UTF-8 bytes:", bytes)
    let text = std.string.fromBytes(bytes).unwrapOr("bad")
    @println("Round trip:", text)
    bytes[0] = 0xFF
    @println("Independent snapshot:", text)
    match std.string.fromBytes(bytes) {
        .ok => @panic("expected invalid UTF-8")
        .err => |error| @println("Invalid UTF-8:", error)
    }
    let nul = "a\0b"
    @println("NUL: {@len(std.string.toBytes(nul))} bytes, {@len(nul)} scalars")
}
