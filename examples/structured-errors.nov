let std = @import("std")
let Result = std.Result

let Entry = struct {
    name: str,
    size: uint,

    let describe: (self: Entry) -> str = "{self.name}: {self.size} bytes"
}

let ErrorKind = enum {
    not_found,
    permission_denied,
    io,
}

let LookupError = struct {
    name: str,
    kind: ErrorKind = .not_found,

    @[stringify]
    let toString: (self: LookupError) -> str = {
        let message = match self.kind {
            .not_found => "entry not found"
            .permission_denied => "permission denied"
            .io => "I/O failure"
        }
        "{self.name}: {message}"
    }
}

let lookup: (name: str) -> Result(Entry, LookupError) = {
    if name == "readme" {
        .ok[Entry.[ name = name, size = 42 ]]
    } else {
        .err[LookupError.[ name = name ]]
    }
}

let describe: (name: str) -> Result(str, LookupError) = .ok[lookup(name).!.describe()]

let report: (name: str) = {
    let message = match describe(name) {
        .ok[text] => text
        .err[error] => match error.kind {
            .not_found => "Error: {error}"
            _ => @panic("Unexpected error: {error}")
        }
    }
    @println(message)
}

let main: () = {
    report("readme")
    report("missing")
}
