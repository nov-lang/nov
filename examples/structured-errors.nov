let std = @import("std")
let Result = std.Result

let Entry = struct {
    name: string,
    size: uint,

    let describe: (self: Entry) -> string = "{self.name}: {self.size} bytes"
}

let ErrorKind = enum {
    not_found,
    permission_denied,
    io,
}

let LookupError = struct {
    name: string,
    kind: ErrorKind = .not_found,

    let toString: (self: LookupError) -> string = {
        let message = match self.kind {
            .not_found => "entry not found"
            .permission_denied => "permission denied"
            .io => "I/O failure"
        }
        "{self.name}: {message}"
    }
}

let lookup: (name: string) -> Result(Entry, LookupError) = {
    if name == "readme" {
        .ok[Entry[ .name = name, .size = 42 ]]
    } else {
        .err[LookupError[ .name = name ]]
    }
}

let describe: (name: string) -> Result(string, LookupError) = .ok[lookup(name).!.describe()]

let report: (name: string) = {
    let message = match describe(name) {
        .ok => |text| text
        .err => |error| match error.kind {
            .not_found => "Error: {error}"
            _ => @panic("Unexpected error: {error}")
        }
    }
    @println(message)
}

let main: () = {
    report("readme")
    report("missing")
}
