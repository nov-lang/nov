; Strings are immutable UTF-8, including on Windows.
let greeting: string = "Hello"

let decorate: (text: string) -> string = "[" + text + "]"

let main: () -> void = {
    let mut text = greeting + ", 世界!"
    let shared = text
    text = decorate("new binding")
    text += "!"
    @println(shared, shared.len)
    @println(text)
    let selected = if true {
        shared
    } else {
        "unused"
    }
    @println(decorate(selected))
; Escaped braces are literal; interpolation is deferred.
    @println("\{UTF-8\}", "😀".len)
; NUL is a valid byte, not an output terminator (length is 3).
    @println("a\0b", "a\0b".len)
}
