; nov run examples/globals.nov
; nov test examples/globals.nov
; Source initializers are known data, not calls to user initialization code.

let shared = @import("globals-state.nov")
let same = @import("./globals-state.nov")

let Color = enum { red, blue, }
let Message = union { values: []int, none, }
let Record = struct {
    label: string,
    rows: []int,
}

let base: int = 4
let initial = base * 2
let mut count = initial
let mut enabled = true
let mut marker = 'λ'
let mut scale = 1.5
let mut color: Color = .red
let mut record = Record.[ label = "ready", rows = [1, 2, 3] ]
let mut message: Message = .values[[6, 7]]
let mut interval = 1..=3
let double: (value: int) -> int = value * 2
let mut callback: (int) -> int = double
let mut live: () -> int = () -> int { count }

; User runtime initialization belongs in main (or a function called from main).
let configure: () -> int = 20

let main: () = {
    @println("Initial:", count, enabled, marker, scale, color)
    count = configure()
    let snapshot = count
    let read = () -> int { count }
    count += 2
    @println("Live:", live(), read(), "Snapshot:", snapshot)

    let saved = record
    record.label = "updated"
    record.rows[1] = 9
    @println("Record:", record.label, record.rows, "Saved:", saved.rows)
    message = .values[[8, 9]]
    @println("Union:", message)

    shared.count = 10
    same.count += 2
    shared.counter.value = 11
    shared.counter.samples[0] = 12
    @println("Imported:", shared.count, same.count, shared.counter.value, shared.counter.samples, shared.readSecret())

    let mut total: uint = 0
    loop n in interval {
        total += n
    }
    @println("Range:", total, "Callback:", callback(5))
    callback = (value: int) -> int { value + count }
    count = 30
    @println("Replaced callback:", callback(5))
}

@[test]
let live_global_reads: () = {
    count = 1
    let read = () -> int { count }
    let saved = count
    count = 9
    @assert(read() == 9 and live() == 9 and saved == 1)
    callback = double
    @assert(callback(3) == 6)
    enabled = false
    marker = 'β'
    scale = 2.5
    color = .blue
    @assert(!enabled and marker == 'β' and scale == 2.5 and color == .blue)
}

@[test]
let aggregate_copies_and_replacement: () = {
    record = Record.[ label = "test", rows = [1, 2, 3] ]
    let saved = record
    record.rows[0] = 99
    @assert(saved.rows[0] == 1 and record.rows[0] == 99)
    message = .values[[8, 9]]
    let old = message
    message = .none[]
    @assert("{old}" == "Message.values[[8, 9]]" and "{message}" == "Message.none")
    interval = 2..=4
    let mut total: uint = 0
    loop n in interval {
        total += n
    }
    @assert(total == 9)
}

@[test]
let imported_storage_identity: () = {
    shared.count = 10
    same.count += 3
    @assert(shared.count == 13 and same.count == 13)
    shared.counter = shared.Counter.[ value = 1, samples = [2, 3] ]
    let saved = shared.counter
    same.counter.value = 8
    shared.counter.samples[1] = 9
    @assert(shared.counter.value == 8 and same.counter.samples[1] == 9)
    @assert(saved.value == 1 and saved.samples[1] == 3)
    @assert(shared.readSecret() == 7)
}
