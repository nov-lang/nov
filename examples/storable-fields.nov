; nov run examples/storable-fields.nov
; nov test examples/storable-fields.nov
; Finite storable fields copy values recursively, but share closure environments.

let std = @import("std")

let Processor = struct {
    run: (int) -> int,
    outcome: std.Result([]int, string),
    interval: @TypeOf(0..10),

    @[stringify]
    let format: (self: Processor) -> string = "Processor({self.run(3)})"

    let apply: (self: Processor, value: int) -> int = self.run(value)
}

let Box: (T: type) -> type = struct {
    value: T,

    let Self = @This()

    let get: (self: Self) -> T = self.value
}

let Report = struct {
    outcome: std.Result([]int, string),
}

let Tools = struct {
    callback: (&mut int, int),
}

let Signed = struct {
    interval: @TypeOf(@as(int, 0)..1),
}

let increment: (value: int) -> int = value + 1
let double: (value: int) -> int = value * 2
let echo: (value: Processor) -> Processor = value
let reportEcho: (value: Report) -> Report = value
let make: () -> Processor = {
    let run = increment
    let outcome: std.Result([]int, string) = .ok[[1, 2]]
    let interval = 1..4
    Processor[ .run, .outcome, .interval ]
}
let counter: () -> Processor = {
    let mut count: int = 0
    Processor[
        .run = (step: int) -> int {
            count += step
            count
        },
        .outcome = .err["counter"],
        .interval = 0..0
    ]
}
let values: (report: Report) -> []int = report.outcome.unwrapOr([])

let main: () = {
    let processor = make()
    @println("Called:", processor.run(4), processor.apply(4))
    @println("Custom:", processor)
    let report = Report[ .outcome = .ok[[1, 2]] ]
    @println("Report:", report)
}

@[test]
let constructors_updates_and_nested_paths: () = {
    let mut box = Box(Processor)[ .value = make() ]
    let saved = box
    box.value.run = double
    box.value.outcome = .err["changed"]
    box.value.interval = 8..=9
    @assert(box.value.run(3) == 6 and saved.value.run(3) == 4)
    @assert(box.get().outcome.isErr() and saved.get().outcome.isOk())
    box.value = Processor[ .run = increment, .outcome = .ok[[7]], .interval = 0..1 ]
    @assert(box.value.apply(7) == 8)
    @assert(saved.value.outcome.unwrapOr([])[0] == 1)
}

@[test]
let union_field_arrays_copy_across_calls: () = {
    let mut source: []int = [1, 2]
    let mut report = Report[ .outcome = .ok[source] ]
    let saved = report
    let returned = reportEcho(report)
    source[0] = 90
    let mut extracted = values(report)
    extracted[0] = 7
    report.outcome = .ok[extracted]
    extracted[0] = 99
    @assert(values(report)[0] == 7)
    @assert(values(saved)[0] == 1 and values(returned)[0] == 1)
    let mut argumentCopy = reportEcho(report)
    argumentCopy.outcome = .err["detached"]
    @assert(report.outcome.isOk() and argumentCopy.outcome.isErr())
    let processors = [make()]
    let mut copied = echo(processors[0])
    copied.outcome = .ok[[8]]
    @assert(processors[0].outcome.unwrapOr([])[0] == 1)
}

@[test]
let escaping_closures_aliases_and_snapshots: () = {
    let mut owner = counter()
    let saved = owner
    let alias = saved.run
    let roots = [Box(Processor)[ .value = echo(saved) ]]
    owner = make()
    let mut pressure: [][]int = []
    loop n in @as(int, 0)..256 {
        pressure += [[n, n + 1]]
    }
    @assert(pressure.len == 256 and alias(1) == 1)
    @assert(saved.run(2) == 3 and roots[0].value.run(3) == 6)
    @assert(counter().run(1) == 1)
    let mut items: []int = [2]
    let snapshot = items
    let captured = Processor[
        .run = (n: int) -> int {
            snapshot[0] + n
        },
        .outcome = .ok[items],
        .interval = 0..0
    ]
    items[0] = 20
    let later = echo(captured)
    @assert(captured.run(3) == 5 and later.run(4) == 6)
}

@[test]
let direct_computed_pipe_and_callee_order: () = {
    let mut processor = make()
    let mut evaluations: int = 0
    let select = () -> Processor {
        evaluations += 1
        processor
    }
    @assert(select().run(3) == 4 and evaluations == 1)
    let piped = 3 |> processor.run
    @assert(piped == 4)
    let result = processor.run(
        {
            processor.run = double
            3
        }
    )
    @assert(result == 4 and processor.run(3) == 6)
    let computed = select().run(
        {
            processor.run = increment
            4
        }
    )
    @assert(computed == 8 and evaluations == 2)
    @assert(processor.apply(4) == 5)

    let add: (p: &mut int, amount: int) = {
        p.* += amount
    }
    let tools = Tools[ .callback = add ]
    let forward: (p: &mut int) = tools.callback(p, 2)
    let mut number: int = 1
    tools.callback(&number, 3)
    forward(&number)
    @assert(number == 6)
}

@[test]
let range_fields_reloop_and_inclusive_max: () = {
    let mut processor = make()
    let saved = processor
    let mut total: uint = 0
    loop n in processor.interval {
        total += n
        processor.interval = 9..10
    }
    loop n in saved.interval {
        total += n
    }
    @assert(total == 12)
    let maximum: uint = 18446744073709551615
    processor.interval = maximum..=maximum
    let mut count = 0
    loop n in processor.interval {
        @assert(n == maximum)
        count += 1
    }
    loop n in processor.interval {
        @assert(n == maximum)
        count += 1
    }

    let signedMax: int = 9223372036854775807
    let edge = Signed[ .interval = signedMax..=signedMax ]
    loop n in edge.interval {
        @assert(n == signedMax)
        count += 1
    }
    @assert(count == 3)
}

@[test]
let generic_fields_methods_and_printing: () = {
    let result = Box(std.Result([]int, string))[ .value = .ok[[4]] ]
    @assert(result.get().unwrapOr([])[0] == 4)
    let function = Box((int) -> int)[ .value = increment ]
    @assert(function.get()(5) == 6 and function.value(6) == 7)
    let ranges = Box(@TypeOf(0..10))[ .value = 2..4 ]
    let mut sum: uint = 0
    loop n in ranges.get() {
        sum += n
    }
    @assert(sum == 5)
    let processor = make()
    @assert("{processor}" == "Processor(4)")
    let report = Report[ .outcome = .ok[[1, 2]] ]
    @assert("{report}" == "Report[ outcome: Result([]i64, string).ok[[1, 2]] ]")
}
