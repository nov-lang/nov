; Local references select an owner without copying it.
let Counter = struct {
    value: int,

    let add: (self: &mut Counter, amount: int) = { self.value += amount }
    let read: (self: &Counter) -> int = self.value
}

let advance: (counter: &mut Counter, amount: int) = { counter.add(amount) }
let describe: (counter: &Counter) = { @println("Readonly count: {counter.read()}") }

let main: () = {
    let mut morning = Counter.[ value = 2 ]
    let mut afternoon = Counter.[ value = 10 ]
    let snapshot = morning
    advance(&morning, 3)
    @println("Morning after advance: {morning.value}")
    @println("Snapshot: {snapshot.value}")

    {
        let mut active: &mut Counter = &morning
        ; Fields and methods automatically dereference the selected owner.
        active.add(2)
        @println("Active morning: {active.value}")

        ; Rebind the reference, then use .* to write through its new target.
        active = &afternoon
        active.* = Counter.[ value = 20 ]
        active.add(4)
        @println("Active afternoon: {active.read()}")
    }

    ; &Counter is readonly even when its owner is mutable.
    {
        let view: &Counter = &afternoon
        describe(view)
        @println("Readonly field: {view.value}")
    }
    afternoon.add(1)
    @println("Final counts: {morning.value}, {afternoon.value}")
}
