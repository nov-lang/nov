; nov run examples/string-bytes.nov
; nov test examples/string-bytes.nov
; String indices read immutable u8 bytes; negative int indices count from the end.

let head: (s: string) -> u8 = s[0]

let main: () = {
    let mut text = "hello"
    let original = text
    text += " world"
    @assert(original == "hello")
    @println(original, text, text[0], text[-1])
    let utf8 = "é\0"
    @println(utf8[0], utf8[1], utf8[-1], utf8.len)
}

@[test]
let ascii_negative: () = {
    let text = "hello"
    let first: int = -5
    @assert(head(text) == 104)
    @assert(text[first] == 104)
    @assert(text[-1] == 111)
    @assert(text[4] == text[-1])
}

@[test]
let utf8_nul: () = {
    let text = "é\0"
    @assert(text[0] == 195)
    @assert(text[1] == 169)
    @assert(text[-1] == 0)
    @assert(text.len == 3)
}

@[test]
let original_snapshot: () = {
    let mut text = "hello"
    let original = text
    text += " world"
    @assert(original == "hello")
    @assert(original[-1] == 111)
    @assert(text[-1] == 100)
}
