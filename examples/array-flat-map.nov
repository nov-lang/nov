let std = @import("std")

let main: () = {
    let expanded = std.array.flatMap(
        [1, 2, 3],
        (x) {
            [x, x]
        }
    )
    @println("Expanded:", expanded)
}

@[test]
let order_empty_results_and_callback_count: () = {
    let mut calls = 0
    let mut seen = 0
    let result = std.array.flatMap(
        [1, 2, 3],
        (x) {
            calls += 1
            seen = seen * 10 + x
            if x == 2 {
                []
            } else {
                [x, x]
            }
        }
    )
    @assert(calls == 3 and seen == 123)
    @assert(@len(result) == 4 and result[0] == 1 and result[2] == 3)
    let empty = std.array.flatMap(
        @as([]int, []),
        (x) {
            calls += 1
            [x]
        }
    )
    @assert(@len(empty) == 0 and calls == 3)
}

@[test]
let flatten_one_layer_and_recursive_independence: () = {
    let identity = (value: `T) -> `T {
        value
    }
    let mut source = [[1], [2, 3]]
    let flattened = std.array.flatMap(source, identity)
    let mut duplicated = std.array.flatMap(
        source,
        (row) {
            [row, row]
        }
    )
    source[0] = [9]
    @assert(flattened[0] == 1 and flattened[-1] == 3)
    @assert(duplicated[0][0] == 1 and duplicated[1][0] == 1)
    duplicated[0] = [8]
    @assert(duplicated[1][0] == 1 and source[0][0] == 9)
}

@[test]
let storable_outputs_and_shared_closures: () = {
    let words = std.array.flatMap(
        [1, 2],
        (x) {
            ["item:{x}"]
        }
    )
    @assert(words[0] == "item:1" and words[1] == "item:2")
    let outcomes: []std.Option([]int) = std.array.flatMap(
        [1],
        (x) -> []std.Option([]int) {
            [std.Option([]int).some[[x]], std.Option([]int).none[]]
        }
    )
    @assert(outcomes[0].unwrapOr([])[0] == 1 and outcomes[1].isNone())
    let ranges = std.array.flatMap(
        [1, 2],
        (x) {
            [x..x + 2]
        }
    )
    @assert(@len(ranges[0]) == 2 and @len(ranges[1]) == 2)
    let mut calls = 0
    let increment = () -> int {
        calls += 1
        calls
    }
    let callbacks = std.array.flatMap(
        [increment],
        (f) {
            [f, f]
        }
    )
    @assert(callbacks[0]() == 1 and callbacks[1]() == 2)
}

@[test]
let snapshots_inference_and_queries: () = {
    let mut source = [1, 2]
    let result = std.array.flatMap(
        source,
        (x) {
            source = [9]
            [x]
        }
    )
    @assert(result[0] == 1 and result[1] == 2 and source[0] == 9)
    let empty: []str = std.array.flatMap(
        [1, 2],
        (x) {
            []
        }
    )
    @assert(@len(empty) == 0)
    let mut calls = 0
    let callback = (x: int) -> []int {
        calls += 1
        [x]
    }
    let query: @TypeOf(std.array.flatMap([1], callback)) = []
    @assert(@len(query) == 0 and calls == 0)
    @assert(std.array.flatMap([7], callback)[0] == 7 and calls == 1)
}
