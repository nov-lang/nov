let std = @import("std")
let Option = std.Option

let divide: (numerator: uint, denominator: uint) -> Option(uint) = {
    if denominator == 0 {
        .none[]
    } else {
        .some[numerator / denominator]
    }
}

let describeDivision: (numerator: uint, denominator: uint) -> Option(string) = {
    let quotient = divide(numerator, denominator).!
    .some["{quotient}"]
}

let fallback: () -> string = {
    @println("Using fallback")
    "0"
}

let main: () = {
    let quotient = describeDivision(42, 2)
    let missing = describeDivision(42, 0)
    @println("Quotient:", quotient.unwrapOrElse(fallback))
    @println("Missing:", missing.unwrapOrElse(fallback))
}
