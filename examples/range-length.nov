; nov run examples/range-length.nov
; nov test examples/range-length.nov

let Interval = @TypeOf(0..1)
let length: (x: `T) -> uint = @len(x)
let interval: () -> Interval = 2..=5
let passed: (value: Interval) -> uint = @len(value)
let fail: () -> int = @panic("type query evaluated an endpoint")

@[test]
let exclusive_inclusive_empty_and_reversed: () = {
    @assert(@len(2..5) == 3 and @len(2..=5) == 4)
    @assert(@len(5..5) == 0 and @len(5..=5) == 1)
    @assert(@len(5..2) == 0 and @len(5..=2) == 0)
    @assert(@len(-3..2) == 5 and @len(-3..=2) == 6)
}

@[test]
let full_narrow_domains_and_native_result: () = {
    let unsigned = @as(u8, 0)..=@as(u8, 255)
    let signed = @as(i8, -128)..=@as(i8, 127)
    @assert(@len(unsigned) == 256 and @len(signed) == 256)
    @assert(@len(@as(u16, 0)..=@as(u16, 65535)) == 65536)
    @assert(@len(@as(u8, 0)..@as(u8, 255)) == 255)
    let count: @TypeOf(@len(unsigned)) = @as(uint, 256)
    let native: uint = count
    @assert(native == 256)
}

@[test]
let stored_passed_returned_and_generic: () = {
    let mut start: uint = 2
    let mut finish: uint = 5
    let stored = start..=finish
    start = 99
    finish = 0
    let copy = stored
    @assert(@len(copy) == 4 and passed(copy) == 4)
    @assert(@len(interval()) == 4 and length(interval()) == 4)
    @assert(length(-3..=2) == 6)
    @assert(length(@as(u8, 0)..=@as(u8, 255)) == 256)
    @assert(length([1, 2, 3]) == 3 and length("é😀") == 2)
}

@[test]
let endpoints_once_left_to_right: () = {
    let mut order = 0
    let first = () -> int {
        order = order * 10 + 1
        @as(int, -2)
    }
    let last = () -> int {
        order = order * 10 + 2
        2
    }
    @assert(@len(first()..=last()) == 5 and order == 12)
    order = 0
    let stored = first()..last()
    @assert(order == 12)
    @assert(length(stored) == 4 and @len(stored) == 4 and order == 12)
}

@[test]
let type_queries_do_not_evaluate: () = {
    let count: @TypeOf(@len(fail()..=fail())) = @as(uint, 7)
    let exclusive: @TypeOf(@len(fail()..fail())) = @as(uint, 8)
    @assert(count == 7 and exclusive == 8)
}

let main: () = {
    @println("Exclusive:", @len(2..5), "Inclusive:", @len(2..=5))
    @println("Empty:", @len(5..5), "Reversed:", @len(5..=2))
    @println("Cross zero:", @len(-3..=2))
    @println("Full u8:", length(@as(u8, 0)..=@as(u8, 255)))
    @println("Stored generic:", length(interval()), "Type:", @TypeOf(@len(interval())))
}
