; nov run examples/integer-defaults.nov
; nov test examples/integer-defaults.nov
; Explicit types and inferred constraints take precedence over the int default.

let answer = 42
let offset = -2

let identity: (value: `T) -> `T = value
let same: (first: `T, second: `T) -> `T = first
let combine: (first: `A, second: `B) -> `C = first + second

let Box: (T: type) -> type = struct {
    value: T,
}

let box: (value: `T) -> Box(`T) = Box(`T)[ .value = value ]
let unbox: (value: Box(`T)) -> `T = value.value

let main: () = {
    let numbers = [1, 2, 3]
    @println("Defaults:", answer, offset, 1 + 2, "{42}")
    @println("Array:", numbers)
    let narrow: u8 = 7
    let inferred = [1, narrow]
    let exact: []u8 = inferred
    @println("Context:", exact, same(1, narrow))
    @println("Generic:", identity(42), combine(1, 2), unbox(box(3)))
}

@[test]
let defaults_and_control_flow: () = {
    let value = 1
    let exact: int = value
    let nested = [[1], [2, 3]]
    let exact_nested: [][]int = nested
    let selected = if true {
        1
    } else {
        2
    }
    let matched = match 1 {
        0 => 2
        _ => 3
    }
    let repeated = loop {
        break 4
    }
    @assert(exact == 1 and exact_nested[1][1] == 3)
    @assert(selected == 1 and matched == 3 and repeated == 4)
    @assert("{1}" == "1")
    @assert(1 in [1, 2])
}

@[test]
let constraints_precede_defaulting: () = {
    let narrow: u8 = 7
    let numbers = [1, narrow]
    let exact_numbers: []u8 = numbers
    let branch = if true {
        1
    } else {
        narrow
    }
    let exact_branch: u8 = branch
    let generic = same(1, narrow)
    let exact_generic: u8 = generic
    let from_result: u8 = identity(1)
    let nested = unbox(box(3))
    let exact_nested: int = nested
    @assert(exact_numbers[0] == 1 and exact_branch == 1)
    @assert(exact_generic == 1 and from_result == 1 and exact_nested == 3)
    loop index in 0..3 {
        let exact_index: uint = index
        @assert(exact_index < 3)
    }
}
