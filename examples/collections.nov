; Clean up a batch of scores, then summarize the accepted results.
let std = @import("std")

let main: () = {
    let raw: []int = [72, -5, 90, 48, 65, 100]
    let valid = std.array.filter(
        raw,
        (score) { score >= 0 }
    )
    let adjusted = std.array.map(
        valid,
        (score) { std.math.clamp(score + 5, 0, 100) }
    )
    let ranked = std.array.sort(
        adjusted,
        (a, b) { a > b }
    )
    @println("Raw scores: {raw}")
    @println("Adjusted ranking: {ranked}")

    let passing = std.array.count(
        ranked,
        (score) { score >= 70 }
    )
    let total = std.array.fold(
        ranked,
        0,
        (sum, score) { sum + score }
    )
    @println("Passing: {passing} of {@len(ranked)}")
    @println("Total points: {total}")
    match std.array.findLastIndex(
        ranked,
        (score) { score >= 70 }
    ) {
        .some[index] => { @println("Last passing index: {index}") }
        .none => { @println("No passing scores") }
    }

    ; Extrema are optional, so the same queries also handle an empty batch.
    match std.array.min(ranked) {
        .some[score] => { @println("Lowest score: {score}") }
        .none => { @println("No lowest score") }
    }
    match std.array.max(ranked) {
        .some[score] => { @println("Highest score: {score}") }
        .none => { @println("No highest score") }
    }
    let empty: []int = []
    match std.array.min(empty) {
        .some[score] => { @println("Empty batch minimum: {score}") }
        .none => { @println("Empty batch has no minimum") }
    }

    ; Editing a copied ranking does not change the published results.
    let mut preview = ranked
    preview[0] = 0
    @println("Preview: {preview}")
    @println("Published ranking: {ranked}")
}
