let std = @import("std.nov")
let Option = std.Option

@[public]
let map: (items: []`T, convert: (`T) -> `U) -> []`U = {
    let mut result: []`U = []
    loop item in items {
        result += [convert(item)]
    }
    result
}

@[public]
let filter: (items: []`T, predicate: (`T) -> bool) -> []`T = {
    let mut result: []`T = []
    loop item in items {
        if predicate(item) {
            result += [item]
        }
    }
    result
}

@[public]
let fold: (items: []`T, initial: `U, combine: (`U, `T) -> `U) -> `U = {
    let mut result: `U = initial
    loop item in items {
        result = combine(result, item)
    }
    result
}

@[public]
let any: (items: []`T, predicate: (`T) -> bool) -> bool = {
    loop item in items {
        if predicate(item) {
            return true
        }
    }
    false
}

@[public]
let all: (items: []`T, predicate: (`T) -> bool) -> bool = {
    loop item in items {
        if predicate(item) == false {
            return false
        }
    }
    true
}

@[public]
let find: (items: []`T, predicate: (`T) -> bool) -> Option(`T) = {
    loop item in items {
        if predicate(item) {
            return .some[item]
        }
    }
    .none[]
}

@[public]
let findIndex: (items: []`T, predicate: (`T) -> bool) -> Option(uint) = {
    loop item, index in items, 0.. {
        if predicate(item) {
            return .some[index]
        }
    }
    .none[]
}

@[public]
let each: (items: []`T, action: (`T)) = {
    loop item in items {
        action(item)
    }
}
