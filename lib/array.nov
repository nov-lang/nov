let std = @import("std.nov")
let Option = std.Option

@[public]
let map: (items: []`T, convert: (`T) -> `U) -> []`U = {
    let mut result: []`U = []
    loop item in items { result += [convert(item)] }
    result
}

@[public]
let flatMap: (items: []`T, convert: (`T) -> []`U) -> []`U = {
    let mut result: []`U = []
    loop item in items { result += convert(item) }
    result
}

@[public]
let reverse: (items: []`T) -> []`T = {
    let mut result: []`T = []
    let mut index: int = -1
    loop _ in items {
        result += [items[index]]
        index -= 1
    }
    result
}

@[public]
let filter: (items: []`T, predicate: (`T) -> bool) -> []`T = {
    let mut result: []`T = []
    loop item in items {
        if predicate(item) { result += [item] }
    }
    result
}

; Stable insertion sort: O(n^2) comparisons/shifts in the worst case.
; Ordinary value copies may add recursive-copy overhead.
@[public]
let sort: (items: []`T, lessThan: (`T, `T) -> bool) -> []`T = {
    let mut result: []`T = items
    let mut index: int = 0
    loop item in items : index += 1 {
        let mut position = index
        loop position > 0 and lessThan(item, result[position - 1]) : position -= 1 { result[position] = result[position - 1] }
        result[position] = item
    }
    result
}

@[public]
let fold: (items: []`T, initial: `U, combine: (`U, `T) -> `U) -> `U = {
    let mut result: `U = initial
    loop item in items { result = combine(result, item) }
    result
}

@[public]
let any: (items: []`T, predicate: (`T) -> bool) -> bool = {
    loop item in items {
        if predicate(item) { return true }
    }
    false
}

@[public]
let all: (items: []`T, predicate: (`T) -> bool) -> bool = {
    loop item in items {
        if predicate(item) == false { return false }
    }
    true
}

@[public]
let find: (items: []`T, predicate: (`T) -> bool) -> Option(`T) = {
    loop item in items {
        if predicate(item) { return .some[item] }
    }
    .none[]
}

@[public]
let findLast: (items: []`T, predicate: (`T) -> bool) -> Option(`T) = {
    let mut index: int = -1
    loop _ in items {
        let item = items[index]
        if predicate(item) { return .some[item] }
        index -= 1
    }
    .none[]
}

@[public]
let min: (items: []`T) -> Option(`T) = if @len(items) == 0 { .none[] } else { .some[@min(items)] }

@[public]
let max: (items: []`T) -> Option(`T) = if @len(items) == 0 { .none[] } else { .some[@max(items)] }

@[public]
let take: (items: []`T, count: uint) -> []`T = {
    let mut result: []`T = []
    loop item, index in items, 0.. {
        if index >= count { break }
        result += [item]
    }
    result
}

@[public]
let drop: (items: []`T, count: uint) -> []`T = {
    let mut result: []`T = []
    loop item, index in items, 0.. {
        if index >= count { result += [item] }
    }
    result
}

@[public]
let findIndex: (items: []`T, predicate: (`T) -> bool) -> Option(uint) = {
    loop item, index in items, 0.. {
        if predicate(item) { return .some[index] }
    }
    .none[]
}

@[public]
let each: (items: []`T, action: (`T)) = {
    loop item in items { action(item) }
}
