let std = @import("std.nov")

@[public]
let Utf8Error = enum {
    invalidUtf8,
}

@[public]
let toBytes: (text: string) -> []u8 = @stringToBytes(text)

let isValidUtf8: (bytes: []u8) -> bool = {
    let mut remaining: u8 = 0
    let mut lower: u8 = 0x80
    let mut upper: u8 = 0xBF
    loop byte in bytes {
        if remaining != 0 {
            if byte < lower or byte > upper {
                return false
            }
            remaining -= 1
            lower = 0x80
            upper = 0xBF
        } else {
            if byte <= 0x7F {
                continue
            }
            if byte >= 0xC2 and byte <= 0xDF {
                remaining = 1
            } else if byte == 0xE0 {
                remaining = 2
                lower = 0xA0
            } else if byte == 0xED {
                remaining = 2
                upper = 0x9F
            } else if byte >= 0xE1 and byte <= 0xEC or byte >= 0xEE and byte <= 0xEF {
                remaining = 2
            } else if byte == 0xF0 {
                remaining = 3
                lower = 0x90
            } else if byte >= 0xF1 and byte <= 0xF3 {
                remaining = 3
            } else if byte == 0xF4 {
                remaining = 3
                upper = 0x8F
            } else {
                return false
            }
        }
    }
    remaining == 0
}

@[public]
let fromBytes: (bytes: []u8) -> std.Result(string, Utf8Error) = {
    if isValidUtf8(bytes) == false {
        return .err[ .invalidUtf8 ]
    }
    .ok[@stringFromBytes(bytes)]
}

@[public]
let startsWith: (text: string, prefix: string) -> bool = {
    if prefix.len > text.len {
        return false
    }
    loop scalar, index in prefix, @as(int, 0).. {
        if text[index] != scalar {
            return false
        }
    }
    true
}

@[public]
let endsWith: (text: string, suffix: string) -> bool = {
    if suffix.len > text.len {
        return false
    }
    loop _, index in suffix, @as(int, 0).. {
        let offset = -1 - index
        if text[offset] != suffix[offset] {
            return false
        }
    }
    true
}

@[public]
let find: (text: string, pattern: string) -> std.Option(uint) = {
    if pattern.len == 0 {
        return .some[0]
    }
    loop _, offset, index in text, @as(int, 0).., 0.. {
        if startsWith(text[offset..], pattern) {
            return .some[index]
        }
    }
    .none[]
}

@[public]
let contains: (text: string, pattern: string) -> bool = find(text, pattern).isSome()

@[public]
let join: (parts: []string, separator: string) -> string = {
    let mut result = ""
    let mut first = true
    loop part in parts {
        if first == false {
            result = result + separator
        }
        result = result + part
        first = false
    }
    result
}

@[public]
let split: (text: string, separator: string) -> []string = {
    if separator.len == 0 {
        @panic("string split separator must not be empty")
    }
    ; String slices require native int bounds.
    let mut width: int = 0
    loop _ in separator {
        width += 1
    }
    let mut result: []string = []
    let mut start: int = 0
    loop _, index in text, @as(int, 0).. {
        if index < start {
            continue
        }
        if startsWith(text[index..], separator) {
            result += [text[start..index]]
            start = index + width
        }
    }
    result += [text[start..]]
    result
}
