@[public]
let Result: (T: type, E: type) -> type = union {
    ok: T,
    err: E,

    let Self = @This()

    @[public]
    let isOk: (self: Self) -> bool = match self {
        .ok => true
        .err => false
    }

    @[public]
    let isErr: (self: Self) -> bool = match self {
        .ok => false
        .err => true
    }

    @[public]
    let map: (self: Self, convert: (T) -> `U) -> Result(`U, E) = {
        let value = self.!
        .ok[convert(value)]
    }

    @[public]
    let mapErr: (self: Self, convert: (E) -> `F) -> Result(T, `F) = match self {
        .ok => |value| .ok[value]
        .err => |error| .err[convert(error)]
    }

    @[public]
    let unwrapOr: (self: Self, fallback: T) -> T = match self {
        .ok => |value| value
        .err => fallback
    }

    @[public]
    let unwrapOrElse: (self: Self, fallback: (E) -> T) -> T = match self {
        .ok => |value| value
        .err => |error| fallback(error)
    }
}
